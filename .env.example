# 复制为 .env 后按需修改（docker compose 会自动读取）
COMPOSE_PROJECT_NAME=hjy_data_pull

# 基础镜像（Docker Hub 拉不下来时可改用代理源，见 README）
# DOCKER_BASE_IMAGE=docker.1ms.run/library/python:3.11-slim-bookworm
DOCKER_BASE_IMAGE=python:3.11-slim-bookworm

WEB_PORT=8765
REDIS_HOST_PORT=6379

CONFIG_PATH=config/config.yaml
REDIS_HOST=redis
REDIS_PORT=6379
TZ=Asia/Shanghai

# 实验性 OperantID（也可用 config.yaml 的 operantid.api_key）
# OPERANTID_API_KEY=
# OPERANTID_PROVIDER=gemini
# OPERANTID_MODEL=gemini-2.0-flash
# OPERANTID_BASE_URL=
